{
  "name": "pomelo-techops-portal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "server": "node server/index.js",
    "dev:all": "concurrently -n BFF,VITE -c cyan,yellow \"npm run server\" \"npm run dev\"",
    "build": "vite build",
    "start": "node server/index.js",
    "db:migrate": "node server/migrate.js",
    "db:seed": "node server/seed.js",
    "lint": "eslint src server PomeloTechOpsPortal.jsx --ext .js,.jsx",
    "lint:fix": "eslint src server PomeloTechOpsPortal.jsx --ext .js,.jsx --fix",
    "format": "prettier --write \"src/**/*.{js,jsx}\" \"server/**/*.js\" PomeloTechOpsPortal.jsx",
    "format:check": "prettier --check \"src/**/*.{js,jsx}\" \"server/**/*.js\" PomeloTechOpsPortal.jsx",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "prepare": "husky"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "server/**/*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "PomeloTechOpsPortal.jsx": [
      "eslint --fix",
      "prettier --write"
    ]
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/node": "^10.53.1",
    "@sentry/react": "^10.53.1",
    "axios": "^1.16.1",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "docx": "^9.6.1",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "file-saver": "^2.0.5",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "jszip": "^3.10.1",
    "lucide-react": "^1.17.0",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^5.6.205",
    "pg": "^8.13.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^15.0.0",
    "zod": "^3.25.76"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@playwright/test": "^1.58.2",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.8.1",
    "vite": "^6.4.3"
  }
}
