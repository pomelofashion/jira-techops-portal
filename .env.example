# ============================================================
# Pomelo TechOps Portal — Environment Variables Reference
# ============================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# (.env.local is covered by .gitignore)
#
# ⚠️  VITE_ prefix warning: Any variable prefixed with VITE_
# is bundled into client-side JavaScript at build time and is
# readable by anyone with access to the deployed app.
# API tokens and secrets must NOT use the VITE_ prefix.
# They are now held server-side in the BFF proxy (server/index.js).
# See Sprint 1 of the APEX audit plan (2026-04-06).
# ============================================================

# ------------------------------------------------------------
# BFF Proxy — Server-Side Secrets (NO VITE_ prefix)
# These are read by server/index.js ONLY. Never bundled.
# Start the proxy with: npm run server  (or npm run dev:all)
# ------------------------------------------------------------

# Anthropic API (Claude AI — document content extraction)
# Server-side only. Replaces the old VITE_ANTHROPIC_API_KEY.
ANTHROPIC_API_KEY=

# Jira Integration (REST API v3 — PESD1 project)
# Server-side only. Replaces the old VITE_JIRA_API_TOKEN.
# Format: base64("your-email@example.com:your-atlassian-api-token")
JIRA_API_TOKEN=

# Restrict the BFF proxy to your deployed frontend origin (production only).
# Accepts a comma-separated list, e.g. staging + production.
# In dev the Vite proxy handles /api/* so this is not needed locally.
# ALLOWED_ORIGIN=https://your-deployed-app.example.com

# BFF server port (optional — defaults to 3001)
# BFF_PORT=3001

# Shared secret for the Jira webhook (REQUIRED in production — the webhook
# rejects all traffic until it is set). Configure the Jira webhook URL as
# https://<bff-host>/api/v1/jira/webhook?token=<this value>
# JIRA_WEBHOOK_SECRET=

# Session-cookie Secure flag override. Defaults to true in production.
# Set to 'false' only for TLS-less internal deployments.
# COOKIE_SECURE=

# ------------------------------------------------------------
# Database (Postgres) — production persistence
# Leave unset locally to keep running on mock/localStorage data.
# When set, DB-backed routes (auth, tickets, users, roles, docs) activate.
# ------------------------------------------------------------
# DATABASE_URL=postgres://user:pass@host:5432/techops
# DATABASE_SSL=disable          # set to 'disable' only for a local Postgres without TLS

# First-superadmin bootstrap — used ONLY by `npm run db:seed`.
# SEED_SUPERADMIN_EMAIL=you@yourdomain.com
# SEED_SUPERADMIN_PASSWORD=change-me-to-a-strong-password
# SEED_SUPERADMIN_NAME=Your Name

# ------------------------------------------------------------
# Auth — session signing (REQUIRED once DATABASE_URL is set)
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ------------------------------------------------------------
# JWT_SECRET=
# Public base URL of the app, used to build email verification/invite links.
# APP_URL=https://your-deployed-app.example.com

# ------------------------------------------------------------
# AWS S3 — file attachments (presigned uploads/downloads)
# IAM user scoped to just this bucket. NO VITE_ prefix.
# ------------------------------------------------------------
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# S3_BUCKET=

# ------------------------------------------------------------
# Transactional email — verification, invites, password resets
# Use ONE provider. Resend is fastest to start; SES if you prefer AWS-native.
# ------------------------------------------------------------
# EMAIL_FROM=TechOps <support@yourdomain.com>
# RESEND_API_KEY=
# (SES alternative uses the AWS_* credentials above + AWS_REGION)

# ------------------------------------------------------------
# Client-Side Config (VITE_ prefix — safe to expose, not secrets)
# ------------------------------------------------------------
VITE_JIRA_BASE_URL=https://pomelofashion.atlassian.net
VITE_JIRA_PROJECT_ID=10245
VITE_JIRA_PROJECT_KEY=PESD1
VITE_JIRA_REPORTER_ID=your-atlassian-account-id-here

# ------------------------------------------------------------
# Backend API (docs service — leave blank to use mock data)
# ------------------------------------------------------------
VITE_API_BASE_URL=

# ------------------------------------------------------------
# Legacy — REMOVED in Sprint 1 (2026-04-06)
# These variables are no longer used. Remove from .env.local.
# VITE_ANTHROPIC_API_KEY  → replaced by server-side ANTHROPIC_API_KEY
# VITE_JIRA_API_TOKEN     → replaced by server-side JIRA_API_TOKEN
# ------------------------------------------------------------

# ─── Runtime configuration home (2026-09-01) ─────────────────────────────────
# Real values live in the git-ignored .env file (shared config) and .env.local
# (local-dev overrides, wins over .env). Nothing secret is committed anymore —
# server/config.js and .env.production were removed. Production reads NONE of
# these files: set the same variable names in the Vercel dashboard.
